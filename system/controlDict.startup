FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          fluid;

// Stage 1 (transient start-up). Lets the convection develop so the steady
// solver never sees the pure-conduction state of still air.
// Velocity scale ~ sqrt(g beta dT L) ~ 0.5 m/s, turnover ~ 5 s -> 200 s is ~40 turnovers.
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         200;
deltaT          0.01;

adjustTimeStep  yes;
maxCo           0.8;
maxDeltaT       0.5;

writeControl    adjustableRunTime;
writeInterval   50;
purgeWrite      0;

writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    #includeFunc residuals(p_rgh, U, e)
    #includeFunc wallHeatFlux
    #includeFunc patchAverage(patch=wall, fields=(T))
    #includeFunc patchAverage(patch=base, fields=(T))
    #includeFunc volAverage(T)
}

// ************************************************************************* //
