FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvConstraints;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Safety net while the flow develops. If T ever hits these limits in the
// steady stage, the solution is not physical: check the log, don't trust it.
limitT
{
    type            limitTemperature;
    cellZone        all;
    min             250;
    max             350;
}

