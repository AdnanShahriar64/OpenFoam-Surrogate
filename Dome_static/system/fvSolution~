FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{

    rho
    {
        solver          diagonal;
    }

    rhoFinal
    {
        $rho;
    }

    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0.01;
    }

    "(U|e)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.05;
    }
}

PIMPLE
{
    momentumPredictor           yes;

    nOuterCorrectors            2;
    nCorrectors                 2;
    nNonOrthogonalCorrectors    1;

    pRefCell                    0;
    pRefValue                   0;
}