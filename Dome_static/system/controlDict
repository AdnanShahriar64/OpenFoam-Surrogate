FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

solver          fluid;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         600;

deltaT          0.05;

writeControl    runTime;
writeInterval   10;

purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   8;

runTimeModifiable yes;